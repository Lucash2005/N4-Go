{
  "name": "n4-go",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:audio": "node scripts/generate-audio.mjs",
    "fetch:openjlpt": "node scripts/fetch-openjlpt.mjs",
    "build:vocab": "node scripts/build-vocab.mjs",
    "enrich:vocab": "node scripts/enrich-vocab.mjs",
    "build:vocab:full": "node scripts/build-vocab.mjs && node scripts/enrich-vocab.mjs",
    "regen:changed-audio": "node scripts/regen-changed-audio.mjs",
    "validate:vocab": "node scripts/validate-vocab.mjs",
    "postprocess:vocab": "node scripts/postprocess-vocab.mjs",
    "apply:grammar-overrides": "node scripts/apply-grammar-overrides.mjs",
    "build:content-updates": "node scripts/build-content-updates.mjs",
    "build:content-updates:batch": "node scripts/build-content-updates.mjs --from-batch",
    "gemini:batch": "node scripts/batch-gemini-fix.mjs",
    "gemini:batch:resume": "node scripts/batch-gemini-fix.mjs --resume",
    "gemini:batch:recheck": "node scripts/batch-gemini-fix.mjs --resume --recheck",
    "gemini:batch:apply": "node scripts/batch-gemini-fix.mjs --apply-only",
    "gemini:daily": "node scripts/run-daily-gemini-slice.mjs --days=5",
    "gemini:daily:recheck": "node scripts/run-daily-gemini-slice.mjs --recheck --days=5",
    "gemini:daily:small": "node scripts/run-daily-gemini-slice.mjs --recheck --days=3",
    "gemini:daily:large": "node scripts/run-daily-gemini-slice.mjs --recheck --days=7",
    "gemini:progress": "node scripts/sync-gemini-progress.mjs --daily-quota=75",
    "merge:local-fixes": "node scripts/merge-local-card-fixes.mjs",
    "audit:vocab": "node scripts/audit-vocab.mjs",
    "audit:quality": "node scripts/audit-quality.mjs",
    "build:example-zh": "node scripts/build-example-zh-cache.mjs",
    "build:example-zh:force": "FORCE=1 node scripts/build-example-zh-cache.mjs",
    "build:example-zh:lazy": "ONLY_LAZY=1 node scripts/build-example-zh-cache.mjs"
  },
  "dependencies": {
    "edge-tts-universal": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
